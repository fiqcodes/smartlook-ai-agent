# Store real values in .env.local (local) or Vercel environment settings.
GROQ_API_KEY=
GOOGLE_CLOUD_PROJECT=
GCP_SERVICE_ACCOUNT_JSON=
GROQ_MODEL=openai/gpt-oss-120b

# Required on Vercel. Use a random secret of at least 32 characters.
APP_SECRET_KEY=
APP_ACCESS_PASSWORD=
# Vercel Marketplace Upstash Redis can also inject KV_REST_API_URL/TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Usage budgets; apply separately to production and preview.
CHAT_REQUESTS_PER_MINUTE=5
IP_REQUESTS_PER_MINUTE=10
DAILY_CHAT_LIMIT=200
BIGQUERY_MAX_BYTES_BILLED=1000000000
BIGQUERY_TIMEOUT_SECONDS=45
MAX_RESULT_ROWS=1000
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_TOKENS=4096
SESSION_TTL_SECONDS=86400
